<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_bg"
    tools:context=".ui.ChartActivity">

    <!-- ══ TOP BAR ═══════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="100dp"
        android:layout_height="38dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:gravity="center"
        android:text="Symbol (TF)"
        android:textColor="#ECEFF1"
        android:letterSpacing="0.05"
        app:autoSizeMaxTextSize="22sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        app:layout_constraintEnd_toStartOf="@+id/buttonHome"
        app:layout_constraintStart_toEndOf="@+id/imageViewLogo"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/buttonHome"
        android:layout_width="46dp"
        android:layout_height="38dp"
        android:background="@color/default_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/home_btn" />

    <!-- ══ TOOLBAR ═══════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/chartTypeBar"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:background="@color/default_bg"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTitle">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Chart type chips -->
            <TextView
                android:id="@+id/btnChartCandle"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="Candle"
                android:textSize="12sp"
                android:textColor="#ECEFF1"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_active"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnChartBar"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="Bar"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnChartLine"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="Line"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="12dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#383636"
                android:layout_marginEnd="10dp" />

            <!-- Timeframe chips -->
            <TextView
                android:id="@+id/button5m"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="5m"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/button15m"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="15m"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/button1h"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="1H"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/button1d"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="1D"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="12dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#383636"
                android:layout_marginEnd="10dp" />

            <!-- Indicators chip -->
            <TextView
                android:id="@+id/indicatorsButton"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="⊕ Indicators"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/drawingPanel"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="⊕ Draw"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="6dp"/>

            <!-- Divider after Indicators (already exists — keep it) -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#383636"
                android:layout_marginEnd="6dp"
                android:layout_marginStart="6dp" />

            <!-- ← NEW: Presets chip -->
            <TextView
                android:id="@+id/btnPresets"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="🗂 Presets"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="6dp" />

            <!-- ← NEW: Divider before AI (replaces the old one) -->
            <View
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:background="#383636"
                android:layout_marginEnd="10dp" />

            <!-- AI button — from user's file, including ProgressBar overlay -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/btnAiAnalyze"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_ai_sparkle"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="AI Analysis" />

                <ProgressBar
                    android:id="@+id/pbAiLoading"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnCalculateBias"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="⚖ Bias"
                android:textSize="12sp"
                android:textColor="#FFC107"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:background="@drawable/chart_btn_inactive"
                android:layout_marginEnd="8dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══ CHART AREA ════════════════════════════════════════════════
         LinearLayout wraps main chart + two optional sub-chart panes.
         Constrained top=toolbar, bottom=zoomControlsBar.
         Sub-charts are GONE by default; StockChart shows/hides them.
    -->
    <!-- REPLACE only the chartAreaContainer block in your existing activity_chart.xml.
     The rest of the file (toolbar, bottom panel, orders section) stays identical.

     Find this block:
         <LinearLayout android:id="@+id/chartAreaContainer" ...>
             ...all content...
         </LinearLayout>

     Replace the entire block with what's below.
-->

    <!-- ══ CHART AREA ════════════════════════════════════════════════
         Main chart takes weight=3.
         Sub-charts are dynamically added below by StockChart into
         subChartsContainer (a vertical LinearLayout inside a ScrollView).
         The outer LinearLayout has no fixed height — it fills the space
         between the toolbar and the zoom bar via constraints.
    -->
    <LinearLayout
        android:id="@+id/chartAreaContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chartTypeBar"
        app:layout_constraintBottom_toTopOf="@+id/zoomControlsBar">

        <!-- Main price chart — weight=3, always visible -->
        <com.example.gutapp.ui.chart.DrawingChart
            android:id="@+id/stockChart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@color/default_bg"
            android:animateLayoutChanges="false" />

        <!--
            Sub-chart scroll area.
            height=0dp + weight=1 → takes 25% of the container when visible.
            StockChart calls setScrollerWeight(0f) / (1f) to show/hide it
            without the weight fighting the main chart's 75%.

            Visibility starts GONE — StockChart sets VISIBLE when any
            sub-chart indicator (RSI, MACD, …) is active.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/subChartsScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:background="#0D0C0C"
            android:visibility="gone"
            android:fillViewport="false"
            android:scrollbars="vertical">

        <!--
            StockChart programmatically adds one LineChart child per
            active sub-chart indicator. A 1dp divider is prepended
            above each chart. Everything scrolls vertically inside the
            NestedScrollView.
        -->
            <LinearLayout
                android:id="@+id/subChartsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="12dp"
                android:clipToPadding="false"/>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- OHLCV floating overlay, top-left of chart -->
    <TextView
        android:id="@+id/candleDataTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/candle_data_background"
        android:lineSpacingExtra="3dp"
        android:textColor="#B0BEC5"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:layout_margin="8dp"
        android:visibility="invisible"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="@+id/chartAreaContainer"
        app:layout_constraintTop_toTopOf="@+id/chartAreaContainer" />

    <!-- ══ ZOOM CONTROLS ════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/zoomControlsBar"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:background="@color/default_bg"
        android:gravity="center_vertical|end"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomPanel">

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:text="−"
            android:textSize="16sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:background="@drawable/chart_btn_inactive"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnZoomReset"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="⊡"
            android:textSize="13sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/chart_btn_inactive"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:text="+"
            android:textSize="16sp"
            android:textColor="#78909C"
            android:gravity="center"
            android:background="@drawable/chart_btn_inactive" />

    </LinearLayout>

    <!-- ══ BOTTOM PANEL ═════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/default_bg"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/sectionDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textViewName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/metadataContainer"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Ticker"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/metadataContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="@color/colorTextDim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExchange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="@color/colorTextDim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvSector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="..."
                    android:textColor="@color/colorTextDim"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewPrice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="000.000"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonBuy"
                android:layout_width="80dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/colorPriceUp"
                android:text="Buy"
                android:textAllCaps="false"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/buttonSell"
                android:layout_width="80dp"
                android:layout_height="38dp"
                android:backgroundTint="@color/colorPriceDown"
                android:text="Sell"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ ORDERS ══════════════════════════════════════════════════ -->
    <View
        android:id="@+id/sectionDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#2E2C2C"
        app:layout_constraintBottom_toTopOf="@+id/ordersHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/ordersHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="4dp"
        android:layout_marginTop="8dp"
        android:text="ACTIVE ORDERS"
        android:textColor="#2E2C2C"
        android:textSize="11sp"
        android:letterSpacing="0.12"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/ordersFragmentContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="#2E2C2C"
        app:layout_constraintBottom_toBottomOf="@+id/ordersHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ordersHeader"
        app:layout_constraintTop_toTopOf="@+id/ordersHeader" />

    <FrameLayout
        android:id="@+id/ordersFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/emptyOrdersView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/ordersFragmentContainer"
        app:layout_constraintEnd_toEndOf="@+id/ordersFragmentContainer"
        app:layout_constraintStart_toStartOf="@+id/ordersFragmentContainer"
        app:layout_constraintTop_toTopOf="@+id/ordersFragmentContainer">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No active positions for this ticker"
            android:textColor="#3E3C3C"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/indicatorsScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#AA000000"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>