<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/default_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header row: title + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="#26A69A"
                android:layout_marginEnd="8dp"
                android:contentDescription="AI" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="AI Article Analysis"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnArticleAiClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/white"
                android:contentDescription="Close" />
        </LinearLayout>

        <!-- Loading state -->
        <LinearLayout
            android:id="@+id/aiLoadingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="24dp">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analyzing article…"
                android:textColor="@color/colorTextDim"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ── Results (hidden until ready) ── -->
        <LinearLayout
            android:id="@+id/aiResultContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Overall verdict -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVERALL"
                    android:textColor="#88FFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/aiOverallSentiment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Neutral"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/aiSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:lineSpacingExtra="4sp"
                android:text="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AFFECTED SYMBOLS"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Rows inflated at runtime -->
            <LinearLayout
                android:id="@+id/aiSymbolsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/aiNoSymbols"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No specific symbols stood out for this article."
                android:textColor="@color/colorTextDim"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="AI-generated · not financial advice"
                android:textColor="#666666"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
