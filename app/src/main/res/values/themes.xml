<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GutApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#383636</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="android:windowBackground">#121111</item>
        <item name="android:colorBackground">#121111</item>

        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">#888888</item>

        <item name="android:statusBarColor">#121111</item>
        <item name="android:navigationBarColor">#121111</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121111</item>
        <item name="android:windowBackground">#121111</item>

        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>

        <item name="postSplashScreenTheme">@style/Theme.GutApp</item>

        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>