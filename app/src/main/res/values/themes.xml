<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GutApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#383636</item>
        <item name="colorPrimaryVariant">#191C81</item>
        <item name="colorOnPrimary">#1B1A1A</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:colorBackground">#121111</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        

        <!-- Customize your theme here. -->
    </style>
    <!-- ... your main app theme ... -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121111</item>

        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <item name="postSplashScreenTheme">@style/Base.Theme.GutApp</item>

        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- ── Unified dialog theme ────────────────────────────────────── -->
    <!--
        Uses Theme.AppCompat.Dialog.Alert as parent so that the standard
        AlertDialog.Builder correctly reads android:windowBackground and
        colorAccent. ThemeOverlay variants only work with MaterialAlertDialogBuilder.
    -->
    <style name="GutDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rounded_dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:textColor">#ECEFF1</item>
        <item name="android:textColorPrimary">#ECEFF1</item>
        <item name="android:textColorSecondary">#90A4AE</item>
        <item name="colorAccent">#26A69A</item>
        <item name="android:colorBackground">#1C1B1B</item>
    </style>

    <style name="IndicatorSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#546E7A</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
</resources>